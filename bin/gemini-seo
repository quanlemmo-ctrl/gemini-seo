#!/usr/bin/env bash
set -euo pipefail

# Stable Antigravity CLI entrypoint for Gemini SEO
launcher_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
root_dir="${launcher_dir}/.."
run_seo="${root_dir}/run_seo.py"

if [[ ! -f "${run_seo}" ]]; then
    echo "run_seo.py is missing from project root." >&2
    exit 2
fi

# Prefer dedicated .venv if available
if [[ -x "${root_dir}/.venv/bin/python" ]]; then
    exec "${root_dir}/.venv/bin/python" "${run_seo}" "$@"
fi

# Custom python override
if [[ -n "${GEMINI_SEO_PYTHON:-}" && -x "${GEMINI_SEO_PYTHON}" ]]; then
    exec "${GEMINI_SEO_PYTHON}" "${run_seo}" "$@"
fi

if command -v python3 >/dev/null 2>&1; then
    exec python3 "${run_seo}" "$@"
fi

if command -v python >/dev/null 2>&1; then
    exec python "${run_seo}" "$@"
fi

echo "Python 3 is required but not found." >&2
exit 2
