---
import AffiliateButton from './AffiliateButton.astro';

export interface Props {
  title: string;
  badge?: string;
  rating: number; // e.g. 9.2
  ratingMax?: number;
  image?: string;
  quickVerdict: string;
  pros?: string[];
  cons?: string[];
  price?: string;
  affiliateUrl: string;
  affiliateText?: string;
}

const {
  title,
  badge = "Editor's Choice",
  rating,
  ratingMax = 10,
  image,
  quickVerdict,
  pros = [],
  cons = [],
  price,
  affiliateUrl,
  affiliateText = 'Check Best Price',
} = Astro.props;
---

<div class="my-8 rounded-2xl bg-gradient-to-br from-slate-50 to-emerald-50/20 dark:from-slate-900 dark:to-emerald-950/20 border-2 border-emerald-500/30 p-6 md:p-8 shadow-sm">
  <!-- Top Header Bar -->
  <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-800">
    <div class="space-y-1">
      {badge && (
        <span class="inline-block text-xs uppercase font-extrabold tracking-wider text-emerald-700 dark:text-emerald-300 bg-emerald-100 dark:bg-emerald-950 px-3 py-1 rounded-full border border-emerald-300 dark:border-emerald-800">
          ★ {badge}
        </span>
      )}
      <h3 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-slate-100">
        {title}
      </h3>
    </div>

    <!-- Rating Score Badge -->
    <div class="flex items-center gap-2 bg-white dark:bg-slate-800 px-4 py-2 rounded-xl shadow-sm border border-slate-200/80 dark:border-slate-700">
      <div class="text-right">
        <div class="text-[10px] uppercase font-bold text-slate-400">Our Score</div>
        <div class="text-2xl font-black text-emerald-600 dark:text-emerald-400 leading-none">
          {rating}
          <span class="text-xs font-normal text-slate-400">/{ratingMax}</span>
        </div>
      </div>
      <div class="w-2.5 h-10 rounded-full bg-emerald-500"></div>
    </div>
  </div>

  <!-- Body Content -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 py-5 items-center">
    {image && (
      <div class="flex justify-center md:col-span-1">
        <img
          src={image}
          alt={title}
          loading="lazy"
          class="max-h-48 object-contain rounded-lg drop-shadow-md"
        />
      </div>
    )}

    <div class={`space-y-3 ${image ? 'md:col-span-2' : 'md:col-span-3'}`}>
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Quick Verdict</h4>
        <p class="text-sm md:text-base text-slate-700 dark:text-slate-300 leading-relaxed font-medium">
          {quickVerdict}
        </p>
      </div>

      {(pros.length > 0 || cons.length > 0) && (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-xs">
          {pros.length > 0 && (
            <div class="space-y-1">
              <span class="font-bold text-emerald-600 dark:text-emerald-400">Top Pros:</span>
              <ul class="space-y-1">
                {pros.slice(0, 2).map((item) => (
                  <li class="flex items-start gap-1.5 text-slate-600 dark:text-slate-400">
                    <span class="text-emerald-500 font-bold shrink-0">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {cons.length > 0 && (
            <div class="space-y-1">
              <span class="font-bold text-rose-600 dark:text-rose-400">Top Cons:</span>
              <ul class="space-y-1">
                {cons.slice(0, 2).map((item) => (
                  <li class="flex items-start gap-1.5 text-slate-600 dark:text-slate-400">
                    <span class="text-rose-500 font-bold shrink-0">✗</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}
    </div>
  </div>

  <!-- Bottom Action Bar -->
  <div class="pt-4 border-t border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-4">
    {price ? (
      <div>
        <span class="text-xs text-slate-400 block">Retail Price</span>
        <span class="text-xl font-black text-slate-900 dark:text-slate-100">{price}</span>
      </div>
    ) : (
      <div></div>
    )}

    <AffiliateButton
      href={affiliateUrl}
      text={affiliateText}
      size="lg"
      variant="primary"
    />
  </div>
</div>
