---
export interface Props {
  author: string;
  role?: string;
  avatar?: string;
  bio?: string;
  publishedDate?: Date;
  updatedDate?: Date;
  factChecked?: boolean;
}

const {
  author,
  role = 'Lead Tech Reviewer & Analyst',
  avatar,
  bio = 'Over 8 years evaluating consumer technology, audio gear, and SaaS tools with rigorous hands-on testing.',
  publishedDate,
  updatedDate,
  factChecked = true,
} = Astro.props;
---

<div class="my-8 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 md:p-6 space-y-4">
  <div class="flex items-start gap-4">
    <!-- Avatar -->
    <div class="w-14 h-14 rounded-full bg-emerald-600/10 text-emerald-600 flex items-center justify-center font-bold text-xl border border-emerald-500/20 shrink-0 overflow-hidden">
      {avatar ? (
        <img src={avatar} alt={author} class="w-full h-full object-cover" />
      ) : (
        <span>{author.charAt(0)}</span>
      )}
    </div>

    <!-- Info -->
    <div class="space-y-1 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <span class="font-bold text-base text-slate-900 dark:text-slate-100">{author}</span>
        <span class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold bg-emerald-50 dark:bg-emerald-950 px-2 py-0.5 rounded border border-emerald-200 dark:border-emerald-800">
          {role}
        </span>
        {factChecked && (
          <span class="inline-flex items-center gap-1 text-xs text-blue-600 dark:text-blue-400 font-semibold bg-blue-50 dark:bg-blue-950 px-2 py-0.5 rounded border border-blue-200 dark:border-blue-800">
            <svg class="w-3 h-3 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            Fact-Checked
          </span>
        )}
      </div>

      <p class="text-xs md:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        {bio}
      </p>
    </div>
  </div>

  {(publishedDate || updatedDate) && (
    <div class="text-[11px] text-slate-400 dark:text-slate-500 pt-2 border-t border-slate-200/60 dark:border-slate-800/80 flex flex-wrap gap-4">
      {publishedDate && <span>Published: {publishedDate.toLocaleDateString('en-US', { dateStyle: 'medium' })}</span>}
      {updatedDate && <span>• Last Updated: {updatedDate.toLocaleDateString('en-US', { dateStyle: 'medium' })}</span>}
      <span>• Independent Editorial Standards</span>
    </div>
  )}
</div>
