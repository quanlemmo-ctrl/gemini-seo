---
export interface Props {
  title: string;
  store: string;
  storeLogo?: string;
  code?: string;
  discount: string;
  description?: string;
  expiryDate?: string;
  affiliateUrl: string;
  verified?: boolean;
  exclusive?: boolean;
  usedCount?: number;
}

const {
  title,
  store,
  storeLogo,
  code,
  discount,
  description,
  expiryDate,
  affiliateUrl,
  verified = true,
  exclusive = false,
  usedCount = 142,
} = Astro.props;

const cardId = `coupon-${Math.random().toString(36).substring(2, 9)}`;
---

<div class="relative bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 md:p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col md:flex-row items-start md:items-center justify-between gap-5 group">
  <!-- Left Column: Discount Badge & Info -->
  <div class="flex items-start gap-4 flex-1">
    <!-- Discount Badge -->
    <div class="flex flex-col items-center justify-center w-20 h-20 md:w-24 md:h-24 rounded-xl bg-gradient-to-br from-emerald-500/10 to-teal-500/10 dark:from-emerald-500/20 dark:to-teal-500/20 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 p-2 text-center shrink-0">
      <span class="text-xs font-bold uppercase tracking-wider">Save</span>
      <span class="text-lg md:text-xl font-extrabold leading-tight">{discount}</span>
    </div>

    <!-- Details -->
    <div class="space-y-1.5 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">{store}</span>
        {verified && (
          <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/80 px-2 py-0.5 rounded-md border border-emerald-200/60 dark:border-emerald-800/40">
            <svg class="w-3 h-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            Verified Today
          </span>
        )}
        {exclusive && (
          <span class="text-[11px] font-bold text-amber-800 dark:text-amber-300 bg-amber-100 dark:bg-amber-950/80 px-2 py-0.5 rounded-md border border-amber-300 dark:border-amber-800">
            ★ Exclusive
          </span>
        )}
      </div>

      <h3 class="text-base md:text-lg font-bold text-slate-900 dark:text-slate-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
        {title}
      </h3>

      {description && (
        <p class="text-sm text-slate-600 dark:text-slate-400 line-clamp-2">
          {description}
        </p>
      )}

      <div class="flex items-center gap-4 text-xs text-slate-400 dark:text-slate-500 pt-1">
        <span>Used by {usedCount.toLocaleString()} shoppers</span>
        {expiryDate && <span>• Expires: {expiryDate}</span>}
      </div>
    </div>
  </div>

  <!-- Right Column: Interactive CTA / Reveal Code -->
  <div class="w-full md:w-auto flex md:flex-col items-center justify-end gap-2 shrink-0">
    {code ? (
      <div class="w-full md:w-48 text-center" id={cardId}>
        <button
          type="button"
          data-code={code}
          data-url={affiliateUrl}
          class="coupon-cta-btn w-full relative flex items-center justify-between bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-bold py-2.5 px-4 rounded-xl shadow-md hover:shadow-lg transition-all cursor-pointer overflow-hidden group/btn"
        >
          <span class="btn-text text-sm">Show Code</span>
          <span class="border-l border-emerald-500/60 pl-2.5 text-xs font-mono tracking-widest text-emerald-100 uppercase">
            {code.slice(0, 3)}***
          </span>
        </button>
        <span class="text-[11px] text-slate-400 mt-1 block">Copies code & opens store</span>
      </div>
    ) : (
      <a
        href={affiliateUrl}
        target="_blank"
        rel="sponsored nofollow noopener noreferrer"
        class="w-full md:w-44 inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-4 rounded-xl shadow-md hover:shadow-lg transition-all text-sm cursor-pointer"
      >
        <span>Get Deal</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    )}
  </div>
</div>

<script>
  // Lightweight event listener for click-to-copy and open store
  document.querySelectorAll('.coupon-cta-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const button = e.currentTarget as HTMLButtonElement;
      const code = button.getAttribute('data-code');
      const url = button.getAttribute('data-url');
      const textSpan = button.querySelector('.btn-text');

      if (code) {
        navigator.clipboard.writeText(code).catch(() => {});
        if (textSpan) textSpan.textContent = 'COPIED!';
        button.classList.remove('bg-emerald-600', 'hover:bg-emerald-700');
        button.classList.add('bg-slate-800', 'text-emerald-400');

        // Open affiliate link in new window/tab
        if (url) {
          window.open(url, '_blank', 'noopener,noreferrer');
        }

        setTimeout(() => {
          if (textSpan) textSpan.textContent = code;
        }, 1200);
      }
    });
  });
</script>
