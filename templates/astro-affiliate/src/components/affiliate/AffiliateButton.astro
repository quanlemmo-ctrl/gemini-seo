---
export interface Props {
  href: string;
  text?: string;
  size?: 'sm' | 'md' | 'lg';
  variant?: 'primary' | 'secondary' | 'deal';
  badge?: string;
  class?: string;
}

const {
  href,
  text = 'Check Best Price',
  size = 'md',
  variant = 'primary',
  badge,
  class: className = '',
} = Astro.props;

const sizeClasses = {
  sm: 'px-3.5 py-1.5 text-xs font-semibold',
  md: 'px-5 py-2.5 text-sm font-bold',
  lg: 'px-7 py-3.5 text-base font-extrabold shadow-lg',
}[size];

const variantClasses = {
  primary: 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-emerald-500/20',
  secondary: 'bg-blue-600 hover:bg-blue-700 text-white shadow-blue-500/20',
  deal: 'bg-amber-500 hover:bg-amber-600 text-slate-950 shadow-amber-500/20',
}[variant];
---

<div class="inline-flex flex-col items-center gap-1 group">
  {badge && (
    <span class="text-[10px] uppercase font-bold tracking-wider text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-2 py-0.5 rounded-full border border-emerald-200 dark:border-emerald-800/60 animate-pulse">
      {badge}
    </span>
  )}
  <a
    href={href}
    target="_blank"
    rel="sponsored nofollow noopener noreferrer"
    class={`relative inline-flex items-center justify-center gap-2 rounded-xl transition-all duration-200 active:scale-95 shadow-md hover:shadow-xl hover:-translate-y-0.5 cursor-pointer ${sizeClasses} ${variantClasses} ${className}`}
  >
    <span>{text}</span>
    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </a>
</div>
