---
import AffiliateButton from './AffiliateButton.astro';

export interface ComparisonItem {
  name: string;
  badge?: string;
  image?: string;
  rating: number;
  specs: Record<string, string>;
  price?: string;
  affiliateUrl: string;
}

export interface Props {
  title?: string;
  items: ComparisonItem[];
  specKeys: string[]; // List of specs to compare, e.g. ["Battery Life", "Weight", "Warranty"]
}

const { title = 'Comparison Matrix', items = [], specKeys = [] } = Astro.props;
---

<div class="my-8 space-y-3">
  {title && (
    <h3 class="text-xl font-bold text-slate-900 dark:text-slate-100">{title}</h3>
  )}

  <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
    <table class="w-full text-left border-collapse min-w-[640px]">
      <thead>
        <tr class="bg-slate-50 dark:bg-slate-800/80 border-b border-slate-200 dark:border-slate-800 text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
          <th class="p-4 w-1/4">Product</th>
          <th class="p-4 text-center">Score</th>
          {specKeys.map((key) => (
            <th class="p-4 text-center">{key}</th>
          ))}
          <th class="p-4 text-center">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-sm">
        {items.map((item) => (
          <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
            <!-- Product Info -->
            <td class="p-4 align-middle">
              <div class="space-y-1">
                {item.badge && (
                  <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300 bg-emerald-100 dark:bg-emerald-950 px-2 py-0.5 rounded">
                    {item.badge}
                  </span>
                )}
                <div class="font-bold text-slate-900 dark:text-slate-100">{item.name}</div>
                {item.price && <div class="text-xs text-slate-500 font-semibold">{item.price}</div>}
              </div>
            </td>

            <!-- Score -->
            <td class="p-4 text-center align-middle font-bold text-emerald-600 dark:text-emerald-400">
              <span class="text-base">{item.rating}</span>
              <span class="text-xs text-slate-400">/10</span>
            </td>

            <!-- Dynamic Specs -->
            {specKeys.map((key) => (
              <td class="p-4 text-center align-middle text-slate-700 dark:text-slate-300">
                {item.specs[key] || '—'}
              </td>
            ))}

            <!-- CTA Button -->
            <td class="p-4 text-center align-middle">
              <AffiliateButton
                href={item.affiliateUrl}
                text="View Deal"
                size="sm"
                variant="primary"
              />
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
