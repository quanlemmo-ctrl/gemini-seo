---
export interface Props {
  siteName?: string;
}

const { siteName = 'DealReviewer' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-slate-600 dark:text-slate-400 py-12 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
    <div class="md:col-span-2 space-y-3">
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-lg bg-emerald-600 flex items-center justify-center text-white font-bold text-sm">
          ⚡
        </div>
        <span class="font-bold text-base text-slate-900 dark:text-white">{siteName}</span>
      </div>
      <p class="text-xs text-slate-500 leading-relaxed max-w-md">
        Your trusted source for in-depth tech product reviews, comprehensive buying guides, and tested daily coupon codes to save you real money.
      </p>
    </div>

    <div class="space-y-2 text-xs">
      <h4 class="font-bold text-slate-900 dark:text-white uppercase tracking-wider">Explore</h4>
      <ul class="space-y-1.5">
        <li><a href="/blog" class="hover:text-emerald-500">Product Reviews</a></li>
        <li><a href="/deals" class="hover:text-emerald-500">Coupons & Promo Codes</a></li>
        <li><a href="/stores" class="hover:text-emerald-500">Featured Stores</a></li>
      </ul>
    </div>

    <div class="space-y-2 text-xs">
      <h4 class="font-bold text-slate-900 dark:text-white uppercase tracking-wider">Legal & Compliance</h4>
      <ul class="space-y-1.5">
        <li><a href="/privacy" class="hover:text-emerald-500">Privacy Policy</a></li>
        <li><a href="/terms" class="hover:text-emerald-500">Terms of Service</a></li>
        <li><a href="/contact" class="hover:text-emerald-500">Contact Us</a></li>
      </ul>
    </div>
  </div>

  <div class="max-w-6xl mx-auto pt-6 border-t border-slate-200 dark:border-slate-800/80 text-xs text-slate-500 flex flex-wrap items-center justify-between gap-4">
    <p>© {currentYear} {siteName}. All rights reserved.</p>
    <p class="text-[11px] text-slate-400">
      Built with Astro 5 & Gemini SEO. Zero tracking bloat.
    </p>
  </div>
</footer>
