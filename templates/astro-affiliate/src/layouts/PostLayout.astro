---
import BaseLayout from './BaseLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import AuthorCard from '../components/affiliate/AuthorCard.astro';
import ReviewBox from '../components/affiliate/ReviewBox.astro';
import ProsCons from '../components/affiliate/ProsCons.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  authorRole?: string;
  authorAvatar?: string;
  image?: string;
  category?: string;
  rating?: number;
  quickVerdict?: string;
  pros?: string[];
  cons?: string[];
  affiliateUrl?: string;
  affiliateText?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  authorRole,
  authorAvatar,
  image,
  category = 'Review',
  rating,
  quickVerdict,
  pros,
  cons,
  affiliateUrl,
  affiliateText,
} = Astro.props;

const pageUrl = Astro.url.href;

// Automated Article or Review Schema
const schema: Record<string, any> = rating
  ? {
      '@context': 'https://schema.org',
      '@type': 'Review',
      headline: title,
      description: description,
      datePublished: pubDate.toISOString(),
      dateModified: (updatedDate || pubDate).toISOString(),
      author: {
        '@type': 'Person',
        name: author,
      },
      itemReviewed: {
        '@type': 'Product',
        name: title.replace(/Review|Best/gi, '').trim(),
      },
      reviewRating: {
        '@type': 'Rating',
        ratingValue: rating,
        bestRating: 10,
        worstRating: 1,
      },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description: description,
      datePublished: pubDate.toISOString(),
      dateModified: (updatedDate || pubDate).toISOString(),
      author: {
        '@type': 'Person',
        name: author,
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
    };
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type="article"
  publishDate={pubDate}
  modifiedDate={updatedDate}
  author={author}
>
  <JsonLd schema={schema} />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
      <a href="/" class="hover:text-emerald-600">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:text-emerald-600">Blog</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-medium truncate">{title}</span>
    </nav>

    <!-- Header -->
    <header class="space-y-4 mb-8">
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950 px-3 py-1 rounded-md border border-emerald-200 dark:border-emerald-800">
        {category}
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        {title}
      </h1>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
        {description}
      </p>
    </header>

    <!-- Author & Trust Box -->
    <AuthorCard
      author={author}
      role={authorRole}
      avatar={authorAvatar}
      publishedDate={pubDate}
      updatedDate={updatedDate}
    />

    <!-- Quick Review Summary Box if rating exists -->
    {rating && quickVerdict && affiliateUrl && (
      <ReviewBox
        title={title}
        rating={rating}
        quickVerdict={quickVerdict}
        pros={pros}
        cons={cons}
        affiliateUrl={affiliateUrl}
        affiliateText={affiliateText}
      />
    )}

    <!-- Main Content -->
    <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-emerald-600 prose-img:rounded-2xl">
      <slot />
    </div>

    <!-- Pros & Cons section if not in review box -->
    {(!rating && pros && cons && (pros.length > 0 || cons.length > 0)) && (
      <ProsCons pros={pros} cons={cons} />
    )}
  </article>
</BaseLayout>
