---
import SeoHead from '../components/seo/SeoHead.astro';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import AffiliateDisclosure from '../components/affiliate/AffiliateDisclosure.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  modifiedDate?: Date;
  author?: string;
  siteName?: string;
}

const {
  title,
  description,
  image,
  type = 'website',
  publishDate,
  modifiedDate,
  author,
  siteName = 'DealReviewer',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      title={title}
      description={description}
      image={image}
      type={type}
      publishDate={publishDate}
      modifiedDate={modifiedDate}
      author={author}
    />
  </head>
  <body class="min-h-screen bg-slate-50/50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 flex flex-col antialiased selection:bg-emerald-500/20 selection:text-emerald-700">
    <Header siteName={siteName} />
    <AffiliateDisclosure />
    <main class="flex-1">
      <slot />
    </main>
    <Footer siteName={siteName} />
  </body>
</html>
