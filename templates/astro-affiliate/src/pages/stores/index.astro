---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allStores = await getCollection('stores');
---

<BaseLayout
  title="All Partner Stores & Brands (2026)"
  description="Explore coupon codes and deals organized by your favorite retail and software brands."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 space-y-8">
    <header class="space-y-2">
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">
        Stores & Brands Directory
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400">
        Find coupons, verified codes, and deals for all popular merchants.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {allStores.map((store) => (
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm hover:shadow-md transition-all space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-bold text-slate-900 dark:text-white">{store.data.name}</h2>
            <span class="text-xs font-extrabold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950 px-2 py-0.5 rounded border border-emerald-200 dark:border-emerald-800">
              {store.data.bestDiscount}
            </span>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-3">
            {store.data.description}
          </p>
          <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
            <span class="text-slate-400">{store.data.totalCoupons} Active Deals</span>
            <a
              href={`/deals`}
              class="font-bold text-emerald-600 hover:text-emerald-700"
            >
              View Coupons →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
