# ==============================================================================
# Gemini SEO (Antigravity Workspace) - Environment Variables Configuration
# ==============================================================================
# Sao chép file này thành .env và điền các API key / thông tin xác thực của bạn.
# Lệnh: cp .env.example .env
# Lưu ý: Tuyệt đối không commit file .env chứa thông tin bí mật lên Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google SEO APIs (Search Console, CrUX, PageSpeed Insights, GA4)
# ------------------------------------------------------------------------------
# API Key chung của Google (Dùng cho PageSpeed Insights v5, CrUX, YouTube Data API)
# Lấy tại: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your_google_api_key_here

# Đường dẫn tới tệp Service Account JSON (cho GSC, Indexing API, GA4)
# Khuyên dùng nếu quản lý website của doanh nghiệp
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json

# Tên thuộc tính Google Search Console mặc định (dạng sc-domain:domain.com hoặc https://domain.com/)
GSC_PROPERTY=sc-domain:example.com

# Thuộc tính Google Analytics 4 (GA4 Property ID dạng 9 chữ số)
GA4_PROPERTY_ID=123456789


# ------------------------------------------------------------------------------
# 2. Gemini & AI APIs (Dành cho AI Image Gen & Phân tích ngữ nghĩa nâng cao)
# ------------------------------------------------------------------------------
# Google AI Studio API Key (cho Gemini models / Imagen)
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_AI_API_KEY=your_gemini_api_key_here

# Mô hình tạo ảnh mặc định (nếu sử dụng tính năng tạo hình ảnh AI cho SEO)
NANOBANANA_MODEL=imagen-3.0-generate-002


# ------------------------------------------------------------------------------
# 3. Backlink & Authority APIs (Moz, Bing, IndexNow)
# ------------------------------------------------------------------------------
# Moz Link Explorer API (Cung cấp Domain Authority - DA, Page Authority - PA, Spam Score)
# Đăng ký tài khoản miễn phí: https://moz.com/products/api
MOZ_ACCESS_ID=your_moz_access_id
MOZ_SECRET_KEY=your_moz_secret_key

# Bing Webmaster Tools API Key (Truy vấn liên kết, lượt crawl từ Bing)
# Lấy tại: https://www.bing.com/webmasters/
BING_WEBMASTER_API_KEY=your_bing_webmaster_api_key

# Giao thức IndexNow (Bắn thông báo lập chỉ mục tức thì cho Bing, Yandex, Naver)
# Tạo key bất kỳ (dài 8-128 ký tự chữ số) và tạo file text trùng tên key trên host
INDEXNOW_KEY=your_indexnow_api_key
INDEXNOW_KEY_LOCATION=https://example.com/your_indexnow_api_key.txt


# ------------------------------------------------------------------------------
# 4. DataForSEO API (Live SERP, Keyword Volume, Google Shopping & Amazon)
# ------------------------------------------------------------------------------
# Tài khoản DataForSEO (yêu cầu nạp tối thiểu để truy vấn dữ liệu live theo pay-as-you-go)
# Đăng ký tại: https://dataforseo.com/
DATAFORSEO_USERNAME=your_dataforseo_email
DATAFORSEO_PASSWORD=your_dataforseo_password


# ------------------------------------------------------------------------------
# 5. Tiện ích mở rộng nâng cao (Tùy chọn - Extensions)
# ------------------------------------------------------------------------------
# Firecrawl API (Cào toàn bộ cấu trúc sitemap và nội dung website quy mô lớn)
FIRECRAWL_API_KEY=your_firecrawl_api_key

# Ahrefs API Token (Dữ liệu backlink và organic keywords từ Ahrefs)
AHREFS_API_TOKEN=your_ahrefs_api_token

# SE Ranking API (Theo dõi AI Share-of-Voice trên ChatGPT, Gemini, Perplexity)
SERANKING_API_KEY=your_seranking_api_key

# Profound API (Theo dõi trích dẫn thương hiệu trong các mô hình LLM)
PROFOUND_API_KEY=your_profound_api_key


# ------------------------------------------------------------------------------
# 6. Cấu hình Runtime Antigravity & Môi trường Python (Tùy chọn)
# ------------------------------------------------------------------------------
# Ghi đè đường dẫn Python runtime nếu không dùng .venv mặc định
# GEMINI_SEO_PYTHON=/path/to/custom/python3

# Thư mục lưu trữ dữ liệu local (drift baselines, SQLite cache). Mặc định là ./data
# GEMINI_SEO_DATA_DIR=./data
